# This file is documentation. Export values in your shell; no automatic .env loading.
CHARACTER_CHAT_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=exaone3.5:7.8b-instruct-q4_K_M
# Previous model, still available: OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512

# Local development only: show full per-request state and model input/output. Not persisted.
CHARACTER_CHAT_DEV=false
